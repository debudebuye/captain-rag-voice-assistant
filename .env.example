# ── OpenAI ──────────────────────────────────────────────
# Required. Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional overrides (sane production defaults provided)
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
TRANSLATION_MODEL=gpt-4o-mini
TTS_MODEL=tts-1
# Captain voice: alloy | echo | fable | onyx | nova | shimmer
TTS_VOICE=onyx

# ── Database ────────────────────────────────────────────
# PostgreSQL with pgvector extension
DATABASE_URL=postgresql://captain:captain@localhost:5432/captain_rag
VECTOR_DIMENSIONS=1536           # must match EMBEDDING_MODEL output size

# ── Server ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Where generated audio files are written and served from
AUDIO_DIR=./audio
AUDIO_BASE_URL=/audio

# ── RAG behaviour ──────────────────────────────────────
TOP_K=5                          # number of chunks retrieved per query
CHUNK_SIZE=500                   # target tokens per chunk
CHUNK_OVERLAP=50                 # tokens of overlap between consecutive chunks
SIMILARITY_THRESHOLD=0.35        # min cosine similarity for a chunk to count as relevant
KNOWLEDGE_BASE_DIR=./knowledge-base
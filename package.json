{
  "name": "captain-rag-voice-assistant",
  "version": "1.0.0",
  "description": "A RAG-based voice assistant for ship/captain operations with grounded generation, translation, and TTS.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed-kb.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.52.0",
    "pg": "^8.11.5",
    "pino": "^9.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.8",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^11.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.15.5",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}

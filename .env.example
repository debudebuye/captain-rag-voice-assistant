# ── Free LLM: Groq ─────────────────────────────────────
# Required. Create a free account at https://console.groq.com
GROQ_API_KEY=

# ── Free Embeddings: Cloudflare Workers AI ─────────────
# Required. API token from https://dash.cloudflare.com (needs Workers AI permission)
CLOUDFLARE_API_TOKEN=
# Required. Your Cloudflare Account ID (shown in the dash.cloudflare.com URL)
CLOUDFLARE_ACCOUNT_ID=

# Optional overrides (sane defaults provided)
GROQ_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_MODEL=@cf/baai/bge-m3
LLM_MODEL=qwen/qwen3.8-27b
TRANSLATION_MODEL=qwen/qwen3.8-27b
TTS_MODEL=edge-tts
# edge-tts voice for the default/fallback language (Amharic male captain).
# Supported output languages auto-select a native male voice:
#   am=am-ET-AmehaNeural  en=en-US-ChristopherNeural  fr=fr-FR-HenriNeural
#   es=es-ES-AlvaroNeural  sw=sw-KE-RafikiNeural  de=de-DE-ConradNeural
# See available voices with: edge-tts --list-voices
TTS_VOICE=am-ET-AmehaNeural

# ── Database ────────────────────────────────────────────
# PostgreSQL with pgvector extension
DATABASE_URL=postgresql://captain:captain@localhost:5432/captain_rag
VECTOR_DIMENSIONS=1024          # must match EMBEDDING_MODEL output size (@cf/baai/bge-m3 = 1024)

# ── Server ─────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Where generated audio files are written and served from
AUDIO_DIR=./audio
AUDIO_BASE_URL=/audio

# ── RAG behaviour ──────────────────────────────────────
TOP_K=5                          # number of chunks retrieved per query
CHUNK_SIZE=500                   # target tokens per chunk
CHUNK_OVERLAP=50                 # tokens of overlap between consecutive chunks
SIMILARITY_THRESHOLD=0.35        # min cosine similarity for a chunk to count as relevant
KNOWLEDGE_BASE_DIR=./knowledge-base